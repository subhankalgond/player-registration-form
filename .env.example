# ARENA AUCTIONS - Environment Configuration
# Copy this to .env and fill in your Supabase project credentials if using live Supabase.
# If left empty, ARENA AUCTIONS automatically operates in high-performance local database mode!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
